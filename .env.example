# Supabase — proyecto "ponelapava".
# La anon key viaja al navegador por diseño: RLS es lo que la limita a
# lectura (ver supabase-migration-store-integrity.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO servidor. Ignora RLS: es la que usan las rutas
# /api/admin/* y la creación de pedidos. Nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# El acceso a /admin es Supabase Auth (src/middleware.ts). No hay
# ADMIN_USER/ADMIN_PASSWORD: el Basic Auth se reemplazó por sesiones reales.
